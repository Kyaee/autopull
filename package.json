{
    "name": "autopull",
    "version": "0.0.1",
    "private": true,
    "description": "A GTK4 application built with GTKX",
    "license": "MIT",
    "author": "Kyaee <efrohibire@gmail.com>",
    "type": "module",
    "imports": {
        "#data/*": "./data/*"
    },
    "scripts": {
        "dev": "gtkx dev",
        "build": "gtkx build",
