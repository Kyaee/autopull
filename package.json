        "react": "^19.3.0"
    },
    "devDependencies": {
        "@gtkx/cli": "^1.6.0",
        "@gtkx/config": "^1.6.0",
        "@gtkx/mcp": "^1.6.0",
        "@gtkx/testing": "^1.6.0",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.0"
    }
